# Frontend configuration.
#
# Base URL of the Node.js/Express backend API (see /server). The backend must be
# running for login, visitors, CCTV detections, alerts and the live map to work.
#
#   1. cd server && cp .env.example .env  (then set JWT_SECRET, DATABASE_URL, etc.)
#   2. cd server && npm install && npm run dev   (API on http://localhost:4000)
#   3. Start the frontend: npm run dev
#
# Never put database passwords, JWT secrets or CCTV credentials in frontend code.
VITE_API_URL=http://localhost:4000/api
