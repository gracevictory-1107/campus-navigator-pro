# ----- Campus Navigator Pro backend -----
# Copy to .env and fill in real values. NEVER commit a real .env.

# HTTP
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGIN=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173

# ----- Database -----
# If DATABASE_URL is set, the server connects to real PostgreSQL.
# If it is left empty (or DB_DRIVER=memory), the server runs on an in-memory
# PostgreSQL fallback (pg-mem) so the demo works without a local DB install.
# Example: postgresql://user:password@localhost:5432/campus_navigator
DATABASE_URL=
DB_DRIVER=

# ----- Auth -----
# REQUIRED in production. Use a long random string. Never commit the real value.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ----- Face verification (simulated) -----
# Provider label only. No biometric data is stored.
FACE_PROVIDER=simulated

# ----- CCTV simulation -----
# The dev simulator endpoint is exposed unless NODE_ENV=production.
# Set to true to keep it enabled in production for controlled demos.
ENABLE_SIMULATION=
